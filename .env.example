# ================================================================
# NUSANTARA STREAM - TELEGRAM MUSIC & VIDEO BOT CONFIGURATION
# ================================================================

# [WAJIB] Telegram API Credentials (Dapatkan dari https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# [WAJIB] Telegram Bot Token (Dapatkan dari @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# [WAJIB] Pyrogram/Kurigram String Session untuk Asisten Userbot
# Generate menggunakan script session generator atau via bot session string
STRING_SESSION=your_pyrogram_string_session_here

# [WAJIB] Telegram User ID Pemilik Bot (Dapatkan dari @userinfobot)
OWNER_ID=123456789

# [OPSIONAL] List ID Admin Tambahan (Pisahkan dengan spasi jika lebih dari satu)
SUDO_USERS=123456789 987654321

# [OPSIONAL] ID Grup/Channel untuk Log Bot (Awali dengan tanda minus, misal -1001234567890)
LOG_GROUP_ID=-1001234567890

# [OPSIONAL] Konfigurasi Streaming
DURATION_LIMIT=3600
DEFAULT_VOLUME=100
AUTO_LEAVE_TIME=300
SEARCH_LIMIT=5
DEFAULT_AUTOPLAY=0

# [OPSIONAL] Konfigurasi Auto-Backup Database
AUTO_BACKUP_ENABLED=True
AUTO_BACKUP_INTERVAL_HOURS=24

# [OPSIONAL] Path file cookies YouTube untuk bypass bot-detection / age-restriction
# COOKIES_FILE=cookies.txt

